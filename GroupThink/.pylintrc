[MAIN]
# Ignore migrations folder (auto-generated by Django) and test files
ignore=migrations
ignore-patterns=test_.*.py

# Load Django plugin
load-plugins=pylint_django
django-settings-module=GroupThink.settings

[MESSAGES CONTROL]
# Disable these messages globally:
# C0103: invalid-name - for module names like GroupThink (project convention)
# R0901: too-many-ancestors - Django forms inherit many classes
# R0801: duplicate-code - test files often have similar setup code
# W0603: global-statement - acceptable for lazy initialization patterns
# R0914: too-many-locals - some functions need many variables
disable=C0103,R0901,R0801,W0603,R0914

[FORMAT]
# Maximum number of characters on a single line
max-line-length=100

[DESIGN]
# Maximum number of local variables
max-locals=25

# Maximum number of branches
max-branches=15

# Maximum number of public methods
max-public-methods=25

# Maximum number of lines in a module
max-module-lines=1200
